APP_NAME="Teacher AI System API"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/teacher_ai_system"
DB_POOL_SIZE="5"
DB_MAX_OVERFLOW="10"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5"
SECRET_KEY="change-me-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES="30"
REFRESH_TOKEN_EXPIRE_MINUTES="43200"
FRONTEND_BASE_URL="http://localhost:5173"
# Comma-separated list of allowed frontend origins. Defaults cover local dev;
# add your deployed frontend origin(s) here in production.
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174"
# uvicorn worker count. Must stay 1 in production — the in-memory rate
# limiter (app/core/rate_limit.py) does not coordinate across workers.
WEB_CONCURRENCY="1"
# SMTP is required in production (password reset emails). Left empty in dev,
# reset links are just logged instead of sent.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_USE_TLS="true"
