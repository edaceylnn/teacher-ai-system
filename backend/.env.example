APP_NAME="Teacher AI System API"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/teacher_ai_system"
DB_POOL_SIZE="5"
DB_MAX_OVERFLOW="10"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5"
# "openai" or "gemini". The public demo runs on Gemini's free tier; set
# OPENAI_API_KEY/OPENAI_MODEL above instead and switch this back when there's
# a budget for a paid provider.
AI_PROVIDER="openai"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
# Cost guardrails for /ai/* generation endpoints. No public signup exists, so
# demo visitors share one login — AI_DAILY_LIMIT_PER_IP caps a single visitor,
# AI_DAILY_LIMIT_GLOBAL caps the whole demo combined (protects the shared
# free-tier quota). Both reset on a rolling 24h window.
AI_DAILY_LIMIT_PER_IP="3"
AI_DAILY_LIMIT_GLOBAL="150"
SECRET_KEY="change-me-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES="30"
REFRESH_TOKEN_EXPIRE_MINUTES="43200"
FRONTEND_BASE_URL="http://localhost:5173"
# Comma-separated list of allowed frontend origins. Defaults cover local dev;
# add your deployed frontend origin(s) here in production.
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174"
# uvicorn worker count. Must stay 1 in production — the in-memory rate
# limiter (app/core/rate_limit.py) does not coordinate across workers.
WEB_CONCURRENCY="1"
# The address uvicorn trusts to supply X-Forwarded-For/-Proto (see
# docker-entrypoint.sh). Only matters once a reverse proxy is in front of
# this server (needed for HTTPS) — otherwise every visitor's rate-limit/
# audit-log identity collapses into the proxy's own address. See the
# Production Checklist in README.md before relying on the default.
FORWARDED_ALLOW_IPS="127.0.0.1"
# SMTP is required in production (password reset emails). Left empty in dev,
# reset links are just logged instead of sent.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_USE_TLS="true"
